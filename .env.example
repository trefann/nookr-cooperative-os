# ---------------------------------------------------------------------------
# Nookr - reference environment
#
# Each package has its own file; copy those, not this one:
#   backend/.env.example   ->  backend/.env
#   frontend/.env.example  ->  frontend/.env
#
# This file lists every variable in one place for deployment.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
# Local demo default is SQLite; production should be PostgreSQL.
DATABASE_URL=sqlite:///./nookr.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nookr

# MUST be a long random string in any deployed environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

ENVIRONMENT=development
COOPERATIVE_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave empty to use the built-in rule engine, which is fully
# functional and needs no network access.
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=https://api.anthropic.com

DEMO_PASSWORD=demo1234

# --- Frontend --------------------------------------------------------------
# Leave empty in development: Vite proxies /api to the backend.
VITE_API_BASE_URL=
