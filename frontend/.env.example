# Base URL of the Nookr API.
# Leave unset for local development: Vite proxies /api to http://127.0.0.1:8000.
# In production set the full origin, e.g. https://nookr-api.onrender.com
VITE_API_BASE_URL=

# Optional: override the dev proxy target if the API runs on another port.
VITE_PROXY_TARGET=http://127.0.0.1:8000
