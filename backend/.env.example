# ---------------------------------------------------------------------------
# Nookr - backend environment
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Database.
# Local zero-setup demo (default when unset):
#   sqlite:///./nookr.db
# PostgreSQL / Supabase:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/nookr
DATABASE_URL=sqlite:///./nookr.db

# JWT signing secret. MUST be overridden in any deployed environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The cooperative's operating timezone. Decides when "today" starts for
# the dashboard and the demand buckets. Any IANA timezone name.
COOPERATIVE_TIMEZONE=Asia/Kolkata

# CORS origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Optional LLM for AI #1 (natural-language service understanding).
# If AI_API_KEY is empty the deterministic rule-based engine is used instead
# and the whole product still works. Nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_SECONDS=12

# Demo password used by the three seeded demo accounts.
DEMO_PASSWORD=demo1234
